[Unit]
Description=ARBY PATCH AGENT - Observer-only update reporting
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/arby-patch-agent
ExecStart=/usr/bin/python3 -m agent report

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

ReadWritePaths=/var/lib/arby-patch-agent
UMask=0077

TimeoutStartSec=180

